# Copier ce fichier en .env (jamais envoyé sur GitHub) et remplir les valeurs.
# Sur Vercel, ces variables se règlent dans Settings → Environment Variables.

# Chaîne de connexion Neon (Vercel → Storage → ta base Neon → .env.local)
DATABASE_URL=postgresql://utilisateur:motdepasse@xxxx.neon.tech/neondb?sslmode=require

# Compte admin : ne pas remplir à la main, lancer « npm run admin:password »
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Stockage des images et du CV envoyés depuis l'admin (Vercel → Storage → Blob → ton store → .env.local)
# Vide en local : les fichiers vont dans public/uploads/ (pour tester seulement, ils ne partent pas en ligne)
BLOB_READ_WRITE_TOKEN=
